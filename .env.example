# Base URL of the MVP Crackers backend.
#
# Port 5000 is already used by another project on this machine, so the
# backend runs on 5055 (see Backend/.env). Keep these two in sync.
VITE_API_URL=http://localhost:5055

# When you deploy, change this to your live API domain, e.g.
# VITE_API_URL=https://api.mvpcrackers.com
#
# NOTE: Vite only reads this file at startup — restart `npm run dev`
# after changing it.
