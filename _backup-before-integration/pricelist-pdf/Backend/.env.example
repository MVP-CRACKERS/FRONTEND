# ─────────────────────────────────────────────────────────────
#  MVP CRACKERS — BACKEND ENVIRONMENT
#  Copy this file to `.env` and fill in the real values.
#  NEVER commit `.env` to git. NEVER expose these to the frontend.
# ─────────────────────────────────────────────────────────────

# Port the Express server listens on.
# NOTE: 5000 is a very common default and is already used by another
# project on this machine — 5055 avoids the clash. If you change it,
# change VITE_API_URL in ../Frontend/.env to match.
PORT=5055

# Node environment: development | production
NODE_ENV=development

# ── DATABASE ────────────────────────────────────────────────
# MongoDB Atlas connection string.
# Get it from: Atlas dashboard -> your Cluster -> "Connect" ->
# "Connect your application" -> copy the driver string, then
# replace <db_password> with your real DB user password and add
# the database name (mvpcrackers) before the "?".
#
# Example (Atlas):
# MONGODB_URI=mongodb+srv://mvpadmin:YOURPASSWORD@cluster0.abcde.mongodb.net/mvpcrackers?retryWrites=true&w=majority
#
# Example (local MongoDB running on your PC):
# MONGODB_URI=mongodb://127.0.0.1:27017/mvpcrackers
MONGODB_URI=

# ── AUTH ────────────────────────────────────────────────────
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# How long an admin login stays valid.
JWT_EXPIRES_IN=7d

# Credentials used ONCE by `npm run seed:admin` to create the
# first admin user. Change the password after first login.
ADMIN_EMAIL=admin@mvpcrackers.com
ADMIN_PASSWORD=ChangeThisPassword123!
ADMIN_NAME=MVP Admin

# ── CORS / URLS ─────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Add your live domain here when you deploy.
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# Public base URL of THIS backend. Used to build invoice URLs
# that are embedded in the WhatsApp message. In production set
# this to your real https domain, e.g. https://api.mvpcrackers.com
PUBLIC_BASE_URL=http://localhost:5055

# ── BUSINESS DETAILS (printed on every invoice) ─────────────
BUSINESS_NAME=MVP CRACKERS
BUSINESS_TAGLINE=CHENNAI'S MVP FOR DIWALI - DIRECT FROM SIVAKASI
BUSINESS_PHONE=+91-9043621639
BUSINESS_EMAIL=manikandan621639@gmail.com
BUSINESS_ADDRESS=24/67a saidapet road vadapalani chennai 600026
BUSINESS_WEBSITE=www.mvpcrackers.com
# Leave blank if you are not GST registered — the line is then
# hidden on the invoice.
GST_NUMBER=
# WhatsApp number in international format, digits only.
WHATSAPP_NUMBER=919043621639

# ── PRICING RULES ───────────────────────────────────────────
# These reproduce the numbers your current checkout screen shows.
# Discount applied to the whole order, in percent.
DISCOUNT_PERCENT=10
# GST/tax applied to the discounted amount, in percent.
TAX_PERCENT=5.833
# Flat delivery charge in rupees. 0 = free delivery.
DELIVERY_CHARGE=0
# Orders at or above this value get free delivery. 0 = rule off.
FREE_DELIVERY_ABOVE=0
# Optional white-bag / packing charge (checkout has a checkbox).
WHITEBAG_CHARGE=0
# Minimum order value in rupees. 0 = no minimum.
MIN_ORDER_VALUE=0
